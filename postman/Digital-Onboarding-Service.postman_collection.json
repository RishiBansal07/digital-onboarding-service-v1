{
  "info": {
    "_postman_id": "digital-onboarding-service-v2",
    "name": "Digital Onboarding Service",
    "description": "Customer onboarding and remote account opening APIs.\n\nFolders:\n1. Happy Path - full register/login/overview flow\n2. Negative - Registration\n3. Negative - Login\n4. Negative - Authorization\n\nDatabase repository operations are queued and started at a maximum of two per second per application instance.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [],
  "item": [
    {
      "name": "1. Happy Path",
      "item": [
        {
          "name": "Register Customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Postman resolves {{username}} using scope precedence:",
                  "//   local > environment > collection > global",
                  "// An environment or global variable of the same name - typically left over",
                  "// from an earlier version of this collection - silently shadows the value we",
                  "// set here, so the request body would send a stale username. Clear the",
                  "// shadowing scopes before writing.",
                  "const username = 'john_doe_' + Date.now();",
                  "pm.environment.unset('username');",
                  "pm.globals.unset('username');",
                  "pm.collectionVariables.set('username', username);",
                  "console.log('→ Registering as:', username);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response echoes the username we sent', function () {",
                  "    const sent = pm.collectionVariables.get('username');",
                  "    const got = pm.response.json().username;",
                  "    if (got !== sent) {",
                  "        console.error('✗ Username mismatch - {{username}} resolved from the wrong scope.');",
                  "        console.error('  sent by script :', sent);",
                  "        console.error('  server received:', got);",
                  "        console.error('  Fix: delete any environment/global variable named username,');",
                  "        console.error('       defaultPassword or authToken, then re-run.');",
                  "    }",
                  "    pm.expect(got).to.eql(sent);",
                  "});",
                  "",
                  "pm.test('Response contains a generated password', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.defaultPassword).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.message).to.eql('Registration successful');",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    // Same shadowing guard as the pre-request script.",
                  "    pm.environment.unset('defaultPassword');",
                  "    pm.globals.unset('defaultPassword');",
                  "    pm.collectionVariables.set('defaultPassword', body.defaultPassword);",
                  "    console.log('✓ Password stored:', body.defaultPassword);",
                  "} else {",
                  "    console.error('✗ Register failed with', pm.response.code, '- login will fail too.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"address\": \"Damrak 1, Amsterdam\",\n  \"username\": \"{{username}}\",\n  \"dateOfBirth\": \"1990-05-20\",\n  \"countryCode\": \"NL\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/register", "host": ["{{baseUrl}}"], "path": ["register"] },
            "description": "Registers a customer, opens a current account and returns the generated password."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const pwd = pm.collectionVariables.get('defaultPassword');",
                  "console.log('🔐 Login using password:', pwd, '(for user:', pm.collectionVariables.get('username'), ')');",
                  "if (!pwd) {",
                  "    console.error('⚠️  defaultPassword is empty! Did Register run and succeed?');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains a token', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.message).to.eql('Login successful');",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.environment.unset('authToken');",
                  "    pm.globals.unset('authToken');",
                  "    pm.collectionVariables.set('authToken', pm.response.json().token);",
                  "    console.log('✓ Token stored:', pm.response.json().token);",
                  "} else {",
                  "    console.error('✗ Login failed. Response:', pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{defaultPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/login", "host": ["{{baseUrl}}"], "path": ["login"] },
            "description": "Exchanges credentials for an opaque session token."
          }
        },
        {
          "name": "Get Account Overview",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns a valid Dutch IBAN account', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.accountNumber).to.match(/^NL\\d{2}[A-Z]{4}\\d{10}$/);",
                  "    pm.expect(body.accountType).to.eql('CURRENT');",
                  "    pm.expect(Number(body.balance)).to.eql(0);",
                  "    pm.expect(body.currency).to.eql('EUR');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/overview", "host": ["{{baseUrl}}"], "path": ["overview"] },
            "description": "Returns the authenticated customer's account overview."
          }
        }
      ]
    },
    {
      "name": "2. Negative - Registration",
      "item": [
        {
          "name": "Duplicate Username (409)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Make this test self-contained: ensure the username already exists.",
                  "//",
                  "const baseUrl = pm.collectionVariables.get('baseUrl');",
                  "const probe = 'duplicate_probe_user';",
                  "pm.environment.unset('duplicateUser');",
                  "pm.globals.unset('duplicateUser');",
                  "pm.collectionVariables.set('duplicateUser', probe);",
                  "",
                  "pm.sendRequest({",
                  "    url: baseUrl + '/register',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({",
                  "            fullName: 'Duplicate Probe',",
                  "            address: 'Damrak 1, Amsterdam',",
                  "            username: probe,",
                  "            dateOfBirth: '1990-05-20',",
                  "            countryCode: 'NL'",
                  "        })",
                  "    }",
                  "}, function (err, res) {",
                  "    // 201 on first run, 409 afterwards - both mean the user now exists.",
                  "    const status = err ? 'error' : res.code;",
                  "    console.log('Seed registration status:', status);",
                  "    // 201 or 409 means the duplicate precondition is satisfied.",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test('Error code is CONFLICT', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.code).to.eql('CONFLICT');",
                  "    pm.expect(body.message).to.eql('Username already exists');",
                  "});",
                  "",
                  "pm.test('Error payload has the standard shape', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.all.keys('code', 'message', 'details', 'timestamp');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Duplicate Probe\",\n  \"address\": \"Damrak 1, Amsterdam\",\n  \"username\": \"{{duplicateUser}}\",\n  \"dateOfBirth\": \"1990-05-20\",\n  \"countryCode\": \"NL\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/register", "host": ["{{baseUrl}}"], "path": ["register"] },
            "description": "Usernames are unique. Registering an existing username must return 409."
          }
