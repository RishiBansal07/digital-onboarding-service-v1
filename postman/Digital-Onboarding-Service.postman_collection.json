                  "",
                  "pm.test('Generic credentials message (no user enumeration)', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.code).to.eql('UNAUTHORIZED');",
                  "    pm.expect(body.message).to.eql('Invalid username or password');",
                  "});",
                  "",
                  "if (pm.response.code === 401) {",
                  "    pm.collectionVariables.set('wrongPasswordMessage', pm.response.json().message);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"definitely-not-the-password\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/login", "host": ["{{baseUrl}}"], "path": ["login"] },
            "description": "Run the Happy Path first so {{username}} exists."
          }
        },
        {
          "name": "Unknown Username (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Message is identical to the wrong-password case', function () {",
                  "    const message = pm.response.json().message;",
                  "    pm.expect(message).to.eql('Invalid username or password');",
                  "",
                  "    const previous = pm.collectionVariables.get('wrongPasswordMessage');",
                  "    if (previous) {",
                  "        // Identical messages prevent username enumeration.",
                  "        pm.expect(message).to.eql(previous);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"no_such_user_at_all\",\n  \"password\": \"any-password\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/login", "host": ["{{baseUrl}}"], "path": ["login"] },
            "description": "Unknown user and wrong password must be indistinguishable."
          }
        },
        {
          "name": "Missing Password (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Reports the missing password', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.code).to.eql('VALIDATION_ERROR');",
                  "    pm.expect(body.details).to.include('Password is required');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/login", "host": ["{{baseUrl}}"], "path": ["login"] },
            "description": "Missing credentials are a validation error, not an auth failure."
          }
        },
        {
          "name": "Blank Username (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Reports the missing username', function () {",
                  "    pm.expect(pm.response.json().details).to.include('Username is required');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"   \",\n  \"password\": \"some-password\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/login", "host": ["{{baseUrl}}"], "path": ["login"] },
            "description": "Blank usernames are rejected by @NotBlank."
          }
        }
      ]
    },
    {
      "name": "4. Negative - Authorization",
      "item": [
        {
          "name": "No Authorization Header (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401, not 500', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Reports a missing header', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.code).to.eql('UNAUTHORIZED');",
                  "    pm.expect(body.message).to.eql('Authorization header is missing');",
                  "});",
                  "",
                  "pm.test('Does not leak an internal error', function () {",
                  "    pm.expect(pm.response.json().code).to.not.eql('INTERNAL_ERROR');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/overview", "host": ["{{baseUrl}}"], "path": ["overview"] },
            "description": "A missing credential is an auth failure (401), never a server error (500)."
          }
        },
        {
          "name": "Non-Bearer Scheme (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Requires the Bearer scheme', function () {",
                  "    pm.expect(pm.response.json().message).to.eql('Authorization header must use Bearer token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Basic dXNlcjpwYXNz" }],
            "url": { "raw": "{{baseUrl}}/overview", "host": ["{{baseUrl}}"], "path": ["overview"] },
            "description": "Basic auth is not accepted."
          }
        },
        {
          "name": "Raw Token Without Bearer Prefix (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Requires the Bearer prefix', function () {",
                  "    pm.expect(pm.response.json().message).to.eql('Authorization header must use Bearer token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "{{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/overview", "host": ["{{baseUrl}}"], "path": ["overview"] },
            "description": "A valid token still fails without the 'Bearer ' prefix. This is the mistake that looks like a missing header in Swagger UI."
          }
        },
        {
          "name": "Empty Bearer Token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Rejected because there is no usable token', function () {",
                  "    // Most HTTP clients trim trailing whitespace in header values, so",
                  "    // 'Bearer    ' can arrive as either 'Bearer ' or 'Bearer'. Both are",
                  "    // rejected, just by different branches, so accept either message.",
                  "    const message = pm.response.json().message;",
                  "    pm.expect(message).to.be.oneOf([",
                  "        'Bearer token is missing',",
                  "        'Authorization header must use Bearer token'",
                  "    ]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer    " }],
            "url": { "raw": "{{baseUrl}}/overview", "host": ["{{baseUrl}}"], "path": ["overview"] },
            "description": "The Bearer prefix with no token is rejected."
          }
        },
        {
          "name": "Unknown Token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Reports an invalid token', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.code).to.eql('UNAUTHORIZED');",
                  "    pm.expect(body.message).to.eql('Invalid or expired token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer 00000000-0000-0000-0000-000000000000" }
            ],
            "url": { "raw": "{{baseUrl}}/overview", "host": ["{{baseUrl}}"], "path": ["overview"] },
            "description": "A well-formed but unknown token is rejected."
          }
        }
      ]
    }
